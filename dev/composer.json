{
  "name": "b4moss/slim-app",
  "description": "Minimal SlimPHP starter from b4moss/git-template (slim branch)",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "php-di/php-di": "^7.0",
    "slim/psr7": "^1.7",
    "slim/slim": "^4.14",
    "symfony/mailer": "^8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "start": "php -S localhost:8080 -t public",
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true
  }
}
