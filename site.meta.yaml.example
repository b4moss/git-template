# Copy to site.meta.yaml and edit for your project.
# site.meta.yaml is gitignored; if missing, this example is used as fallback.
#
# =============================================================================
# 【ここで書くもの】サイト共通 → 全ページの SoftwareSourceCode（#40）
#
#   Markdown の frontmatter には書かない。
#   この YAML を書くと、各ページ JSON-LD の @graph にだいたいこう出る:
#
#   {
#     "@type": "SoftwareSourceCode",
#     "@id": "https://example.com/#software",
#     "name": "My OSS",
#     "codeRepository": "https://github.com/example/my-oss",
#     "license": "MIT",
#     "programmingLanguage": ["TypeScript"]
#   }
#
#   各ページの WebPage / TechArticle は about: { "@id": "…/#software" } で参照する。
#
# フィールド:
#   siteName / siteUrl / githubUrl … UI・URL 生成・フォールバックにも使う
#   software.name                 → SoftwareSourceCode.name（省略時 siteName）
#   software.codeRepository       → codeRepository（省略時 githubUrl）
#   software.license              → license（例: MIT）
#   software.programmingLanguage  → string[]（空 [] なら JSON-LD に出さない）
#
# ページ役割（TechArticle / FAQPage / HowTo）は各 Markdown の schemaRole 側。
# FAQ の Q/A は本文の ::faq-item。詳細は content/*/overview.md や faq.md のコメントへ。
# =============================================================================

siteName: Doc Site
siteUrl: https://example.com
siteVersion: "0.9.0"
description: Nuxt Content documentation site scaffold
githubUrl: https://github.com/b4moss/git-template
footerText: "MIT License · 2026 Bicycle for Mind LLC."

software:
  # → SoftwareSourceCode.name（omit to use siteName）
  name: Doc Site
  # → SoftwareSourceCode.codeRepository（omit to use githubUrl）
  codeRepository: https://github.com/b4moss/git-template
  # → SoftwareSourceCode.license
  license: MIT
  # → SoftwareSourceCode.programmingLanguage（e.g. [ TypeScript, Vue ]）
  programmingLanguage: []
