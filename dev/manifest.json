{
  "manifest_version": 3,
  "name": "CRX Vue Starter",
  "version": "0.1.0",
  "action": {
    "default_popup": "src/views/popup/index.html",
    "default_title": "Open extension"
  },
  "options_page": "src/views/options/index.html",
  "side_panel": {
    "default_path": "src/views/index.html"
  },
  "permissions": [
    "storage",
    "sidePanel"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "https://localhost/*"
      ],
      "js": [
        "src/scripts/content/content.ts"
      ],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "src/scripts/background/background.ts"
  },
  "host_permissions": [
    "http://localhost/*",
    "https://localhost/*"
  ]
}
